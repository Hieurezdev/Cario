# Keep the real .env private and never prefix this key with NEXT_PUBLIC_.
QWEN_BASE_URL=http://your-proxy-host:8080/v1
QWEN_API_KEY=replace-with-your-proxy-key
QWEN_MODEL=Qwen/Qwen3.5-35B-A3B-GPTQ-Int4
QWEN_TIMEOUT=60
MONGODB_URL=mongodb+srv://replace-with-your-connection-string
AUTH_SECRET=replace-with-a-long-random-secret
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
